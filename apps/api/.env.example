NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgres://billleaf:billleaf@localhost:5432/billleaf
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-32+-char-random-string-in-every-env
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with credentials
TRUSTED_ORIGINS=http://localhost:3000
# Set to e.g. .billleaf.com in staging/prod so app. and api. share cookies
COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (mailpit locally)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Billleaf <no-reply@billleaf.local>"
