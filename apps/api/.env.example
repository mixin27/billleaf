NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgres://billleaf:billleaf@localhost:5432/billleaf
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-32+-char-random-string-in-every-env
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with credentials
TRUSTED_ORIGINS=http://localhost:3000
# Set to e.g. .billleaf.com in staging/prod so app. and api. share cookies
COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform admin portal (/admin): comma-separated staff emails; 2FA required
PLATFORM_ADMIN_EMAILS=

# Email (mailpit locally)
# SaaS billing: "test" (simulated checkout, local only) or "manual" (pay by
# bank/wallet + proof, approved in /admin/approvals; used in production)
BILLING_PROVIDER=test
BILLING_WEBHOOK_SECRET=dev-only-billing-webhook-secret

# Chinese/Japanese/Korean PDF fonts are downloaded on first use and cached
# here (default: the OS temp dir). `pnpm --filter api fonts:cjk` pre-fetches.
# PDF_FONT_CACHE_DIR=
# 127.0.0.1, not localhost: nodemailer resolves hostnames through DNS (not
# /etc/hosts), and some local DNS setups never answer for "localhost".
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="Billleaf <no-reply@billleaf.local>"

# Push notifications to the mobile app: "log" (written to the worker log,
# local) or "expo" (sent through Expo's push service). EXPO_ACCESS_TOKEN only
# if the Expo project requires access tokens for sending.
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# Error reporting / tracing (leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Object storage (local: SeaweedFS from infra/docker-compose.dev.yml; prod: R2)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=billleaf-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
