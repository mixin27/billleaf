{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file .env",
    "dev:worker": "nest start --watch --env-file .env --entryFile worker",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "start:worker": "node --import ./dist/instrument.js dist/worker.js",
    "fonts:cjk": "tsx --env-file-if-exists=.env src/fetch-cjk-fonts.ts",
    "openapi:emit": "nest build && node --env-file-if-exists=.env dist/openapi-emit.js",
    "auth:generate": "tsx scripts/generate-auth-schema.ts && prettier --write ../../packages/db/src/schema/auth.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@better-auth/expo": "1.7.25",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/platform-fastify": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@scalar/nestjs-api-reference": "^1.2.37",
    "@sentry/nestjs": "^11.12.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/emails": "workspace:*",
    "@workspace/env": "workspace:*",
    "better-auth": "^1.7.25",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "expo-server-sdk": "^8.0.0",
    "fastify": "^5.12.8",
    "fflate": "0.8.2",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-syntax-decorators": "^8.0.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^22",
    "@types/nodemailer": "*",
    "@types/pdfkit": "^0.17.7",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
