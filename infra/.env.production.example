# Billleaf production environment, set in Dokploy → (compose app) → Environment.
# Copy this list, fill in values, never commit the filled-in file.
# Generate secrets with:  openssl rand -base64 48
# Runbook: docs/infrastructure/dokploy-runbook.md

# ── Release ──────────────────────────────────────────────
# GHCR owner (your GitHub user or org, lower-case) and the image tag to run.
# "production" follows the latest production release (moved by CI).
# To roll back, pin a build: production-sha-<7 chars>, then redeploy.
GHCR_OWNER=your-github-user
IMAGE_TAG=production
# Compose project name suffix: "production", or "staging" for a staging stack
# on the same server (keeps containers and volumes apart).
STACK_NAME=production

# ── URLs and cookies ────────────────────────────────────
# The web app and API live on sub-domains of one domain.
WEB_URL=https://app.example.com
API_URL=https://api.example.com
# Leading dot: shares sign-in and client-portal cookies between app. and api.
COOKIE_DOMAIN=.example.com
# Extra origins allowed to call the API with cookies (comma-separated, optional).
TRUSTED_ORIGINS=

# ── Database (Postgres in this stack) ───────────────────
POSTGRES_USER=billleaf
POSTGRES_PASSWORD=change-me-generate-a-long-random-password
POSTGRES_DB=billleaf

# ── Auth ─────────────────────────────────────────────────
# 32+ random characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=change-me-generate-48-random-bytes
# Optional "Sign in with Google" (Google Cloud console → OAuth client).
# Authorised redirect URI: https://api.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────────
# Resend:      smtps://resend:<API_KEY>@smtp.resend.com:465
# Amazon SES:  smtps://<SMTP_USER>:<SMTP_PASSWORD>@email-smtp.<region>.amazonaws.com:465
SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:465
# Must be on a domain verified with the provider (SPF + DKIM + DMARC).
EMAIL_FROM="Billleaf <no-reply@example.com>"

# ── File storage: Cloudflare R2 (app files) ─────────────
# R2 → bucket "billleaf-production" (private) → API token with Object Read & Write
# on that bucket only. Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=billleaf-production
S3_ACCESS_KEY_ID=r2-access-key-id
S3_SECRET_ACCESS_KEY=r2-secret-access-key

# ── Database backups: Cloudflare R2 (separate bucket + token) ─
# A different bucket and token from the app's, so a leaked app key can't
# delete backups. Nightly pg_dump; old dumps are deleted after N days.
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_BUCKET=billleaf-production-backups
BACKUP_ACCESS_KEY_ID=r2-backup-access-key-id
BACKUP_SECRET_ACCESS_KEY=r2-backup-secret-access-key
BACKUP_RETENTION_DAYS=14

# ── Platform admin ──────────────────────────────────────
# Comma-separated emails of Billleaf staff. They get the /admin portal
# (after turning on 2FA). Removing an email demotes that user on next boot.
PLATFORM_ADMIN_EMAILS=you@example.com

# ── SaaS billing ─────────────────────────────────────────
# "manual": workspaces pay by bank transfer or mobile wallet and a platform
# admin approves the proof (ADR-0013). Set prices and Billleaf's payment
# methods in /admin/pricing. ("test" is refused in production.)
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=change-me-generate-48-random-bytes

# ── Health and monitoring ───────────────────────────────
# Enables GET /health/deep for the post-deploy smoke test (24+ chars).
# Put the same value in the GitHub environment secret HEALTH_CHECK_TOKEN.
HEALTH_CHECK_TOKEN=change-me-generate-48-random-bytes
# Sentry (optional): project DSN for the API and worker.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# Note: the web app's public values (NEXT_PUBLIC_API_URL, NEXT_PUBLIC_APP_URL,
# NEXT_PUBLIC_SENTRY_DSN) are baked in at build time from GitHub repository
# variables (PRODUCTION_*), not set here. See the runbook.
