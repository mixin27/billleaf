{
  "name": "@workspace/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed fetch client generated from the API's OpenAPI document.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:api-client": "pnpm --filter api openapi:emit && openapi-typescript ../../apps/api/openapi.json -o src/schema.d.ts && prettier --write src/schema.d.ts",
    "build": "tsc -p tsconfig.json && cp src/schema.d.ts dist/schema.d.ts",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.0",
    "typescript": "^5"
  }
}
