{
  "name": "@workspace/brand",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Billleaf logo: SVG sources, generated icons/images for web, email and mobile, and React Logo components.",
  "scripts": {
    "assets": "tsx scripts/build-assets.ts",
