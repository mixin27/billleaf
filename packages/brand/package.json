    "@types/opentype.js": "^1",
    "@types/react": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "opentype.js": "^2",
    "react": "19.3.1",
    "sharp": "^0.35",
    "tsx": "^4",
    "typescript": "^7"
  }
